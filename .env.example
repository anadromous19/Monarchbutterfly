# ==============================================================================
# Monarch Citizen Science - Environment Configuration Example
# Copy this file to '.env' or '.env.local' and fill in your AWS deployment values.
# ==============================================================================

# AWS Region where your backend stack is deployed (e.g. us-east-1, us-west-2)
EXPO_PUBLIC_AWS_REGION=us-east-1

# AWS AppSync GraphQL Endpoint URL (from CloudFormation Outputs / AWS Console)
EXPO_PUBLIC_APPSYNC_URL=https://xxxxxxxxxxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql

# Amazon Cognito Identity Pool ID for unauthenticated guest identities
EXPO_PUBLIC_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000

# Private Amazon S3 Bucket Name for photographic evidence storage
EXPO_PUBLIC_S3_EVIDENCE_BUCKET=monarch-evidence-dev-uniqueid

# Optional: Expo Application Services (EAS) Project ID (for cloud builds)
# EAS_PROJECT_ID=your-eas-project-id-here
