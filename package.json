    "build:web": "expo export --platform web",
    "backend:template": "node scripts/generate-cfn.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-tflite": "^1.4.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^4.6.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@10.8.1+sha512.c50088ba998c67b8ca8c99df8a5e02fd2ae2e2b29aaf238feaa9e124248d3f48f9fb6db2424949ff901cffbb5e0f0cc1ad6aedb602cd29450751d11c35023677",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  },
  "pnpm": {
    "overrides": {
      "@react-native/babel-preset": "0.86.3",
      "@react-native/babel-plugin-codegen": "0.86.3",
      "@react-native/codegen": "0.86.3",
      "@react-native/metro-config": "0.86.3",
      "@react-native/metro-babel-transformer": "0.86.3"
    }
